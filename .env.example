# Storage: "sheets" for the demo, "memory" for quick local runs (data resets on restart)
STORE_BACKEND=sheets
GOOGLE_SHEET_ID=
# Either the full service account JSON on one line, or a path to the key file
GOOGLE_SERVICE_ACCOUNT_JSON=./service-account.json

# Paystack TEST secret key only (sk_test_...). The app refuses sk_live_ keys.
PAYSTACK_MODE=paystack
PAYSTACK_SECRET_KEY=sk_test_xxx
# Paystack needs an email; WhatsApp buyers often have none, so a placeholder is generated
PLACEHOLDER_EMAIL_DOMAIN=example.com

# Shared secret Chord sends as "Authorization: Bearer ..." to /mcp. Generate a long random one.
MCP_BEARER_TOKEN=
# PIN gate staff must give the agent before it will check a ticket in
STAFF_PIN=
# Public HTTPS URL of this service (used for ticket links and the Paystack callback)
PUBLIC_BASE_URL=https://your-service.onrender.com
HOLD_MINUTES=15
